{
  "name": "leakfix",
  "version": "0.1.0",
  "description": "Rotate leaked secrets automatically: detect, mint a new credential, redeploy, revoke the old one.",
  "type": "module",
  "bin": {
    "leakfix": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.21.0"
}
