{
  "name": "leakfix",
  "version": "0.2.0",
  "description": "Rotate leaked secrets automatically: detect, mint a new credential, redeploy, revoke the old one.",
  "keywords": [
    "cli",
    "devsecops",
    "github-action",
    "jwt",
    "leaked-secrets",
    "mongodb-atlas",
    "render",
    "secret-rotation",
    "secrets",
    "security",
    "vercel"
  ],
  "author": "Safayet Hossain",
  "homepage": "https://github.com/safayet404/leakfix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safayet404/leakfix.git"
  },
  "bugs": "https://github.com/safayet404/leakfix/issues",
  "type": "module",
  "bin": {
    "leakfix": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.21.0"
}
